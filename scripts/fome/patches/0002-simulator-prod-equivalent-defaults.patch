diff --git a/firmware/controllers/sensors/impl/maf.cpp b/firmware/controllers/sensors/impl/maf.cpp
index ba4a895..e062fa2 100644
--- a/firmware/controllers/sensors/impl/maf.cpp
+++ b/firmware/controllers/sensors/impl/maf.cpp
@@ -1,6 +1,10 @@
 #include "pch.h"
 
 static int addMafPoint(int index, float kgHrValue, float voltage) {
+#if defined(SIM_WITH_BOARD_DEFAULTS)
+	// OPF base-tune generation: negative float -> uint32 saturates to 0 on the ARM FPU (vcvt), but wraps on x86
+	if (kgHrValue < 0) kgHrValue = 0;
+#endif
 	config->mafDecoding[index] = kgHrValue;
 	config->mafDecodingBins[index] = voltage;
 	return index + 1;
